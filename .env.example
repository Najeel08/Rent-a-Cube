# Copy this file to .env for local development. Do not commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_USE_X_FORWARDED_PROTO=False
# Only list your actual reverse proxy IP(s) or CIDR ranges. Leave empty locally.
DJANGO_TRUSTED_PROXY_IPS=
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local simulation only; production always disables this.
ALLOW_DEMO_PAYMENTS=False
DJANGO_TIME_ZONE=Asia/Kolkata
# Enable only after testing the full Razorpay sandbox flow in the browser.
DJANGO_CHECKOUT_CSP_ENFORCE=False
# Keep external integrations disabled until configured.
RAZORPAY_API_KEY=
RAZORPAY_API_SECRET_KEY=
